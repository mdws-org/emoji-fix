{
  "manifest_version": 3,
  "name": "Emoji Fix",
  "version": "1.4.0",
  "description": "Draws emoji with a bundled Noto Color Emoji font on Macs where Chromium browsers draw Apple Color Emoji blank.",
  "minimum_chrome_version": "119",
  "homepage_url": "https://github.com/mdws-org/emoji-fix",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Emoji Fix",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/NotoColorEmoji.woff2"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
